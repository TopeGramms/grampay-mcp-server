# ──────────────────────────────────────────────
# IvoryPay Authentication & Environment
# ──────────────────────────────────────────────
IVORYPAY_SECRET_KEY=sk_test_your_key_here
IVORYPAY_PUBLIC_KEY=pk_test_your_key_here
IVORYPAY_ENV=test

# ──────────────────────────────────────────────
# GramPay Operational Settings
# ──────────────────────────────────────────────
GRAMPAY_MODE=live
GRAMPAY_MAX_CASHOUT_USD=1000
USD_TO_NGN_RATE=1650

# Fallback/Default Bank Settings (Optional)
GRAMPAY_DEFAULT_BANK_NAME=Access Bank
GRAMPAY_DEFAULT_BANK_ACCOUNT=0123456789

# ──────────────────────────────────────────────
# HTTP Server (Claude Connectors)
# ──────────────────────────────────────────────

# Port the HTTP server listens on (hosting platforms set this automatically)
PORT=3000

# Bearer token Claude presents when calling your connector.
# Set this in Claude → Settings → Connectors → Add connector → Authorization header:
#   Authorization: Bearer <value you set here>
# Generate a strong token: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MCP_AUTH_TOKEN=your_secret_bearer_token_here

# Secret used to sign prepare-tokens (stateless JWT).
# Must be set for the HTTP server to start.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=a_long_random_string_for_signing_tokens