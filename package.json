{
  "name": "grampay-mcp-server",
  "version": "1.0.0",
  "description": "Model Context Protocol (MCP) server for converting USDC/Crypto liquidity to Nigerian Naira bank payouts via IvoryPay API",
  "main": "build/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node build/index.js",
    "dev": "tsc && node build/index.js",
    "start:http": "node build/httpServer.js",
    "dev:http": "tsc && node build/httpServer.js"
  },
  "keywords": [
    "mcp",
    "solana",
    "usdc",
    "nigeria",
    "ivorypay",
    "fiat-ramp",
    "superteam"
  ],
  "author": "Superteam Nigeria",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}
